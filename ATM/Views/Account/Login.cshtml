@model ATM.Models.ViewModels.CardLoginViewModel

@{
    ViewData["Title"] = "Đăng nhập ATM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập ATM</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #0f172a, #1e3a8a, #2563eb);
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: #fff;
            border-radius: 18px;
            padding: 38px;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
        }

        .atm-icon {
            width: 75px;
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            border-radius: 20px;
            background: #dbeafe;
            color: #2563eb;
            font-size: 38px;
        }

        .login-title {
            font-size: 25px;
            font-weight: 700;
            color: #1e293b;
        }

        .login-description {
            color: #64748b;
            font-size: 14px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .form-control {
            height: 48px;
            border-radius: 9px;
        }

        .form-control:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.15);
        }

        .btn-login {
            height: 49px;
            border-radius: 9px;
            background: #2563eb;
            border: none;
            color: white;
            font-weight: 600;
            transition: 0.2s;
        }

        .btn-login:hover {
            background: #1d4ed8;
            color: white;
        }

        .security-note {
            margin-top: 22px;
            padding: 12px;
            border-radius: 9px;
            background: #eff6ff;
            color: #1e40af;
            font-size: 12px;
            text-align: center;
        }

        .validation-summary-errors ul {
            margin-bottom: 0;
            padding-left: 20px;
        }

        .footer-text {
            color: #94a3b8;
            font-size: 12px;
            text-align: center;
            margin-top: 22px;
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="text-center">
            <div class="atm-icon">
                <i class="bi bi-credit-card-2-front"></i>
            </div>

            <h2 class="login-title">ATM BANKING</h2>

            <p class="login-description">
                Vui lòng xác thực thẻ để sử dụng dịch vụ ATM
            </p>
        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <div class="mb-3">
                <label asp-for="CardNumber" class="form-label">
                    Số thẻ ATM
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-credit-card"></i>
                    </span>

                    <input asp-for="CardNumber"
                           class="form-control"
                           placeholder="Nhập 16 chữ số trên thẻ"
                           maxlength="16"
                           inputmode="numeric"
                           autocomplete="off" />
                </div>

                <span asp-validation-for="CardNumber"
                      class="text-danger small">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="PIN" class="form-label">
                    Mã PIN
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>

                    <input asp-for="PIN"
                           type="password"
                           class="form-control"
                           placeholder="Nhập mã PIN"
                           maxlength="6"
                           inputmode="numeric"
                           autocomplete="off" />
                </div>

                <span asp-validation-for="PIN"
                      class="text-danger small">
                </span>
            </div>

            <button type="submit" class="btn btn-login w-100">
                <i class="bi bi-box-arrow-in-right me-2"></i>
                ĐĂNG NHẬP
            </button>
        </form>

        <div class="security-note">
            <i class="bi bi-shield-lock-fill me-1"></i>
            Thông tin thẻ và mã PIN của bạn được bảo mật.
            Không chia sẻ mã PIN với người khác.
        </div>

        <div class="footer-text">
            ATM Banking System © 2026
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>